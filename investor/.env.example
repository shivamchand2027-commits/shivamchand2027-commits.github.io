# Preview defaults fail closed. Production credentials belong only in the host secret store.
PORT=8099
PORTAL_ORIGIN=http://127.0.0.1:8099
PORTAL_PREVIEW=true
PORTAL_LIVE=false
GOOGLE_CLIENT_ID=
INVESTOR_SHEET_ID=
# Authenticate Sheets with the host workload identity, not a public JSON key.
BILLING_MODE=pending
TERMS_VERSION=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for payment activation. TLS is required in production via provider URL/CA.
DATABASE_URL=
HOST=127.0.0.1
